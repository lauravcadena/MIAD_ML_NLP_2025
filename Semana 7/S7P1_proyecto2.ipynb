   "source": [
    "## Modelo de clasificación multi-etiqueta basado en BERT"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cargar tokenizador y modelo BERT\n",
    "tokenizer = DistilBertTokenizer.from_pretrained('distilbert-base-uncased')\n",
    "bert_model = DistilBertModel.from_pretrained('distilbert-base-uncased')\n",
    "# Preparar datos para el modelo BERT\n",
    "# Tokenización y creación de tensores\n",
    "# Procesamiento de lotes de datos\n",
    "class MovieDataset(Dataset):\n",
    "    def __init__(self, texts, labels=None, max_len=128): # Definir el tamaño máximo de la secuencia\n",
    "        self.texts = texts\n",
    "        self.labels = labels\n",
    "        self.max_len = max_len\n",
    "        \n",
    "    def __len__(self): # Cantidad de lotes\n",
    "        return len(self.texts)\n",
    "    \n",
    "    def __getitem__(self, idx): # Obtener datos de cada lote\n",
    "        text = str(self.texts.iloc[idx])\n",
    "        \n",
    "        encoding = tokenizer.encode_plus(\n",
    "            text,\n",
    "            add_special_tokens=True,\n",
    "            max_length=self.max_len,\n",
    "            return_token_type_ids=False,\n",
    "            padding='max_length',\n",
    "            truncation=True,\n",
    "            return_attention_mask=True,\n",
    "            return_tensors='pt'\n",
    "        )\n",
    "        \n",
    "        if self.labels is not None:\n",
    "            return {\n",
    "                'input_ids': encoding['input_ids'].flatten(),\n",
    "                'attention_mask': encoding['attention_mask'].flatten(),\n",
    "                'labels': torch.FloatTensor(self.labels[idx])\n",
    "            }\n",
    "        else:\n",
    "            return {\n",
    "                'input_ids': encoding['input_ids'].flatten(),\n",
    "                'attention_mask': encoding['attention_mask'].flatten()\n",
    "            }"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Modelo de clasificación multi-etiqueta basado en BERT\n",
    "class BERTMultiLabelClassifier(nn.Module):\n",
    "    def __init__(self, num_labels): # Número de géneros\n",
    "        super(BERTMultiLabelClassifier, self).__init__()\n",
    "        self.bert = bert_model\n",
    "        self.dropout = nn.Dropout(0.3)\n",
    "        self.classifier = nn.Linear(768, num_labels)\n",
    "        \n",
    "    def forward(self, input_ids, attention_mask): # Entradas de texto\n",
    "        outputs = self.bert(\n",
    "            input_ids=input_ids,\n",
    "            attention_mask=attention_mask\n",
    "        )\n",
    "        pooled_output = outputs.last_hidden_state[:, 0] # Obtener únicamente el token [CLS]\n",
    "        pooled_output = self.dropout(pooled_output)\n",
    "        return torch.sigmoid(self.classifier(pooled_output)) # Aplicar sigmoid para obtener probabilidades entre 0 y 1"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Función para entrenar el modelo\n",
    "def train_model(model, train_loader, val_loader, epochs=3, lr=2e-5):\n",
    "    model.to(device)\n",
    "    \n",
    "    optimizer = optim.Adam(model.parameters(), lr=lr) # Optimizador Adam\n",
    "    criterion = nn.BCELoss() # Función de pérdida\n",
    "    \n",
    "    best_val_score = 0\n",
    "    best_model_state = None\n",
    "    \n",
    "    for epoch in range(epochs): # Iterar por todos los épocas\n",
    "        print(f\"\\nÉpoca {epoch+1}/{epochs}\")\n",
    "        \n",
    "        model.train() # Modo entrenamiento\n",
    "        train_loss = 0\n",
    "        progress = 0\n",
    "        \n",
    "        start_time = time.time()\n",
    "        for batch in train_loader: # Obtener lotes de datos y moverlos a GPU/CPU\n",
    "            input_ids = batch['input_ids'].to(device)\n",
    "            attention_mask = batch['attention_mask'].to(device)\n",
    "            labels = batch['labels'].to(device)\n",
    "            \n",
    "            optimizer.zero_grad() # Reiniciar gradientes\n",
    "            outputs = model(input_ids, attention_mask)\n",
    "            loss = criterion(outputs, labels)\n",
    "            \n",
    "            loss.backward() # Calcular gradientes\n",
    "            optimizer.step()\n",
    "            \n",
    "            train_loss += loss.item()\n",
    "            \n",
    "            progress += 1 # Contador de lotes procesados\n",
    "            if progress % 10 == 0:\n",
    "                print(f\"Batch {progress}/{len(train_loader)}, Loss: {loss.item():.4f}\", end='\\r')\n",
    "        \n",
    "        train_time = time.time() - start_time\n",
    "        train_loss /= len(train_loader)\n",
    "        \n",
    "        model.eval() # Modo evaluación\n",
    "        val_loss = 0\n",
    "        all_predictions = []\n",
    "        all_labels = []\n",
    "        \n",
    "        with torch.no_grad(): # Desactivar gradientes para evaluación\n",
    "            for batch in val_loader:\n",
    "                input_ids = batch['input_ids'].to(device)\n",
    "                attention_mask = batch['attention_mask'].to(device)\n",
    "                labels = batch['labels'].to(device)\n",
    "                \n",
    "                outputs = model(input_ids, attention_mask)\n",
    "                loss = criterion(outputs, labels)\n",
    "                val_loss += loss.item()\n",
    "                \n",
    "                all_predictions.extend(outputs.cpu().numpy())\n",
    "                all_labels.extend(labels.cpu().numpy())\n",
    "        \n",
    "        val_loss /= len(val_loader)\n",
    "        val_roc_auc = roc_auc_score(all_labels, all_predictions, average='macro')\n",
    "        \n",
    "        print(f\"Época {epoch+1}/{epochs}:\")\n",
    "        print(f\"Tiempo: {train_time:.2f}s, Train Loss: {train_loss:.4f}, Val Loss: {val_loss:.4f}, Val ROC AUC: {val_roc_auc:.4f}\")\n",
    "        \n",
    "        if val_roc_auc > best_val_score: # Guardar el mejor modelo\n",
    "            best_val_score = val_roc_auc\n",
    "            best_model_state = model.state_dict().copy()\n",
    "            print(f\"Mejor modelo guardado con ROC AUC: {val_roc_auc:.4f}\")\n",
    "    \n",
    "    # Cargar el mejor modelo\n",
    "    if best_model_state:\n",
    "        model.load_state_dict(best_model_state)\n",
    "        print(f\"Métrica de validación (ROC AUC) del mejor modelo: {best_val_score:.4f}\")\n",
    "    \n",
    "    return model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Función para hacer predicciones en el conjunto de prueba\n",
    "def predict(model, test_loader):\n",
    "    model.eval()\n",
    "    predictions = []\n",
    "    \n",
    "    with torch.no_grad():\n",
    "        for batch in test_loader:\n",
    "            input_ids = batch['input_ids'].to(device)\n",
    "            attention_mask = batch['attention_mask'].to(device)\n",
    "            \n",
    "            outputs = model(input_ids, attention_mask)\n",
    "            predictions.extend(outputs.cpu().numpy())\n",
    "    \n",
    "    return np.array(predictions)"
   ]
  },
