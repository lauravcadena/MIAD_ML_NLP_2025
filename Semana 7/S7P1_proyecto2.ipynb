   "source": [
    "# Pipeline para TF-IDF y clasificación de textos\n",
    "pipeline = Pipeline([\n",
    "    ('tfidf', TfidfVectorizer(max_features=15000, ngram_range=(1, 2))),\n",
    "    ('clf', OneVsRestClassifier(\n",
    "        LogisticRegression(solver='liblinear', C=10.0, class_weight='balanced')\n",
    "    ))\n",
    "])\n",
    "# Definir parámetros para GridSearch\n",
    "param_grid = {\n",
    "    'tfidf__max_features': [5000, 10000],\n",
    "    'tfidf__ngram_range': [(1, 1), (1, 2)],\n",
    "    'clf__estimator': [\n",
    "        LogisticRegression(solver='liblinear', C=1.0),\n",
    "        LogisticRegression(solver='liblinear', C=10.0),\n",
    "    ]\n",
    "}\n",
    "# Grid Search con validación cruzada\n",
    "grid_search = GridSearchCV(\n",
    "    pipeline, \n",
    "    param_grid,\n",
    "    cv=3,\n",
    "    scoring='roc_auc_ovr', # AUC promedio para múltiples clases, aplicable para el problema \n",
    "    verbose=1,\n",
    "    n_jobs=-1\n",
    ")\n",
    "# Entrenamiento del modelo con GridSearch\n",
    "# Se medirá el tiempo para evaluar el rendimiento\n",
    "start_time = time.time()\n",
    "grid_search.fit(X_train, y_train)\n",
    "end_time = time.time()\n",
    "# Evaluación del modelo en el conjunto de validación\n",
    "print(f\"Tiempo para entrenar el modelo: {end_time - start_time:.2f} segundos\")\n",
    "print(f\"Mejores parámetros: {grid_search.best_params_}\")\n",
    "print(f\"Mejor puntuación CV (AUC promedio): {grid_search.best_score_:.5f}\")"
   ]
  },
