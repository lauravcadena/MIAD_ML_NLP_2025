   "source": [
    "# Carga el modelo de lenguaje de spaCy para inglés, previamente descargado desde terminal\n",
    "# python3 -m spacy download en_core_web_sm\n",
    "nlp = spacy.load(\"en_core_web_sm\")\n",
    "# Para evitar errores de memoria, aumentamos el tamaño máximo de los tokens a 1.5M (por defecto es 1M)\n",
    "nlp.max_length = 1500000 \n",
    "# Para mejorar el rendimiento del modelo, no se desactivan los componentes de la librería spaCy\n",
    "# Función de preprocesamiento\n",
    "def preprocess_text(text):\n",
    "    if pd.isna(text): # Verifica si el texto es NaN\n",
    "        return \"\"\n",
    "    doc = nlp(text) # Procesar el texto con spaCy\n",
    "    \n",
    "    tokens = [token.lemma_.lower() for token in doc if not token.is_stop and not token.is_punct and not token.is_digit] \n",
    "    # Filtrar stopwords, puntuación y dígitos\n",
    "    \n",
    "    return ' '.join(tokens) # Unir tokens\n",
    "# Aplicación de la función de preprocesamiento\n",
    "dataTraining['plot_processed'] = dataTraining['plot'].apply(preprocess_text)\n",
    "dataTesting['plot_processed'] = dataTesting['plot'].apply(preprocess_text)\n",
    "# Convertir datos de géneros a etiquetas binarias\n",
    "le = MultiLabelBinarizer()\n",
    "y_genres = le.fit_transform(dataTraining['genres'])\n",
    "print(f\"(Géneros procesados, Dimensiones de etiquetas): {y_genres.shape}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1400x500 with 1 Axes>"
      ]
