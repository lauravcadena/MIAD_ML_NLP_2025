    "# Preparación para el entrenamiento del modelo BERT\n",
    "# Ajuste de parámetros\n",
    "MAX_LEN = 512 # Longitud máxima de la secuencia de los tokens\n",
    "TRAIN_BATCH_SIZE = 16 # Tamaño del batch de entrenamiento, cuantas peliculas procesar por iteración\n",
    "VALID_BATCH_SIZE = 32 # Más eficiente en validación\n",
    "TEST_BATCH_SIZE = 32 # Más eficiente en predicción\n",
    "# Preparación de los datos para el modelo BERT\n",
    "train_dataset = MovieDataset(X_train, y_train, max_len=MAX_LEN)\n",
    "val_dataset = MovieDataset(X_val, y_val, max_len=MAX_LEN)\n",
    "test_dataset = MovieDataset(dataTesting['plot'], max_len=MAX_LEN)\n",
    "train_loader = DataLoader(train_dataset, batch_size=TRAIN_BATCH_SIZE, shuffle=True)\n",
    "val_loader = DataLoader(val_dataset, batch_size=VALID_BATCH_SIZE)\n",
    "test_loader = DataLoader(test_dataset, batch_size=TEST_BATCH_SIZE)\n",
    "# Verificar si hay GPU disponible\n",
    "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
    "# Crear y entrenar modelo\n",
    "model = BERTMultiLabelClassifier(num_labels)\n",
    "trained_model = train_model(model, train_loader, val_loader, epochs=3, lr=2e-5)\n",
    "# Hacer predicciones en el conjunto de prueba\n",
    "test_predictions = predict(trained_model, test_loader)"
