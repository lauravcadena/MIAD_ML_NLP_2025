    "# Preparación de etiquetas para el modelo BERT\n",
    "dataTraining['genres'] = dataTraining['genres'].map(lambda x: eval(x) if isinstance(x, str) else x)\n",
    "le = MultiLabelBinarizer()\n",
    "y_genres = le.fit_transform(dataTraining['genres'])\n",
    "num_labels = y_genres.shape[1]\n",
    "# Separar datos de entrenamiento y validación, 33% para validación con semilla 42\n",
    "X_train, X_val, y_train, y_val = train_test_split(\n",
    "    dataTraining['plot'], \n",
    "    y_genres, \n",
    "    test_size=0.33, \n",
    "    random_state=42\n",
    ")"
   ]
