    "from sklearn.model_selection import ParameterGrid\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "# 1) Define tu espacio de parámetros\n",
    "param_grid = {\n",
    "    \"optimizer\":  ['adam', 'rmsprop'],          \n",
    "    \"neurons\":    [64, 128, 256],                \n",
    "    \"batch_size\": [32, 64],                      \n",
    "    \"epochs\":     [10, 20],                      \n",
    "    \"activation\": ['relu', 'tanh'],              \n",
    "    \"patience\":   [3, 5],                        \n",
    "    \"loss\":       ['binary_crossentropy']        \n",
    "}\n",
    "\n",
    "# 2) Crea una lista donde guardar resultados\n",
    "results = []\n",
    "\n",
    "# 3) Recorre cada combinación\n",
    "for params in ParameterGrid(param_grid):\n",
    "    print(\"Probando:\", params)\n",
    "    # Entrena el modelo con esos parámetros\n",
    "    model = nn_model_params(**params)\n",
    "    \n",
    "    # Extrae del history las métricas de validación\n",
    "    hist = model.history.history\n",
    "    best_val_loss = min(hist['val_loss'])\n",
    "    # Si usas accuracy, úsalo; si no, ignóralo\n",
    "    best_val_acc = max(hist.get('val_accuracy', [np.nan]))\n",
    "    \n",
    "    # Guarda los resultados\n",
    "    results.append({\n",
    "        **params,\n",
    "        \"val_loss\": best_val_loss,\n",
    "        \"val_acc\":  best_val_acc\n",
    "    })\n",
    "\n",
    "# 4) Monta un DataFrame y selecciona la mejor combinación\n",
    "df_results = pd.DataFrame(results)\n",
    "df_results = df_results.sort_values(\"val_loss\")\n",
    "display(df_results.head(5))      # Pantallazo de top 5\n",
    "\n",
    "best_params = df_results.iloc[0].to_dict()\n",
    "print(\"Mejor combinación:\", best_params)\n",
    "\n",
    "# 5) Entrenamiento final con los mejores parámetros\n",
    "final_model = nn_model_params(\n",
    "    optimizer  = best_params['optimizer'],\n",
    "    neurons    = int(best_params['neurons']),\n",
    "    batch_size = int(best_params['batch_size']),\n",
    "    epochs     = int(best_params['epochs']),\n",
    "    activation = best_params['activation'],\n",
    "    patience   = int(best_params['patience']),\n",
    "    loss       = best_params['loss']\n",
    ")\n",
    "\n",
    "# 6) Evaluación final\n",
    "final_val_loss = min(final_model.history.history['val_loss'])\n",
    "y_pred_test   = final_model.predict(X_test)\n",
    "\n",
    "from sklearn.metrics import roc_auc_score\n",
    "test_auc = roc_auc_score(y_test_genres, y_pred_test, average='macro')\n",
    "\n",
    "print(f\"Final val_loss: {final_val_loss:.4f}\")\n",
    "print(f\"Final test AUC : {test_auc:.4f}\")\n"
   ]
  },
