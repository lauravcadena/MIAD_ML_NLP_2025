     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# División de los datos en conjuntos de entrenamiento y validación, 33% para validación con semilla 42\n",
    "X_train, X_val, y_train, y_val = train_test_split(\n",
    "    dataTraining['plot_processed'], \n",
    "    y_genres, \n",
    "    test_size=0.33, \n",
    "    random_state=42,\n",
    "    stratify=y_genres.sum(axis=1)  # Balanceo de clases\n",
    ")\n",
    "# Conteos para cada género en los conjuntos de entrenamiento y validación\n",
    "train_counts = np.sum(y_train, axis=0)\n",
    "val_counts = np.sum(y_val, axis=0)\n",
    "genre_names = le.classes_ # Obtener los nombres de los géneros\n",
    "distribution_df = pd.DataFrame({\n",
    "    'Genre': genre_names,\n",
    "    'Train': train_counts,\n",
    "    'Validation': val_counts\n",
    "})\n",
    "distribution_df['Total'] = distribution_df['Train'] + distribution_df['Validation']\n",
    "distribution_df = distribution_df.sort_values('Total', ascending=True)\n",
    "# Graficar la distribución de géneros\n",
    "plt.figure(figsize=(14, 5))\n",
    "x = np.arange(len(genre_names))\n",
    "width = 0.35\n",
    "bars1 = plt.bar(x - width/2, distribution_df['Train'], width, \n",
    "                label='Entrenamiento', alpha=0.8, color='skyblue')\n",
    "bars2 = plt.bar(x + width/2, distribution_df['Validation'], width, \n",
    "                label='Validación', alpha=0.8, color='lightcoral')\n",
    "plt.xlabel('Géneros')\n",
    "plt.ylabel('Número de Películas')\n",
    "plt.title('Conteo de Géneros por Conjunto')\n",
    "plt.xticks(x, distribution_df['Genre'], rotation=45, ha='right')\n",
    "plt.legend()\n",
    "plt.grid(True, alpha=0.3)\n",
    "# Agregar valores en las barras\n",
    "for bar in bars1:\n",
    "    height = bar.get_height()\n",
    "    plt.annotate(f'{int(height)}',\n",
    "                xy=(bar.get_x() + bar.get_width() / 2, height),\n",
    "                xytext=(0, 3),\n",
    "                textcoords=\"offset points\",\n",
    "                ha='center', va='bottom', fontsize=8)\n",
    "for bar in bars2:\n",
    "    height = bar.get_height()\n",
    "    plt.annotate(f'{int(height)}',\n",
    "                xy=(bar.get_x() + bar.get_width() / 2, height),\n",
    "                xytext=(0, 3),\n",
    "                textcoords=\"offset points\",\n",
    "                ha='center', va='bottom', fontsize=8)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
